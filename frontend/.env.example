# Backend API URL — override for each environment
# Dev:        VITE_API_URL=http://localhost:8000
# Docker:     VITE_API_URL=http://backend:8000   (service name within compose network)
# Staging:    VITE_API_URL=https://api.staging.yourapp.com
# Production: VITE_API_URL=https://api.yourapp.com
VITE_API_URL=http://localhost:8000
